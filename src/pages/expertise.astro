---
import Base from '../layouts/Base.astro';

const stack = {
  primary: ['Autodesk Inventor', 'SolidWorks'],
  secondary: ['Rhinoceros 3D', 'KeyShot'],
  output: ['AutoCAD', 'Adobe Illustrator', 'Bluebeam']
};

const standards = [
  { code: 'AISC 360', desc: 'Specification for Structural Steel Buildings' },
  { code: 'AWS D1.2', desc: 'Structural Welding Code, Aluminum' },
  { code: 'ASME Y14.5', desc: 'Geometric Dimensioning and Tolerancing' },
  { code: 'ADM 2020', desc: 'The Aluminum Association Design Manual' },
  { code: 'Local codes', desc: 'Verified per project jurisdiction' }
];
---
<Base
  title="Expertise — GALVEC Studio"
  description="Deep AEC specialization in aluminum: Inventor and SolidWorks parametric modeling, AISC/AWS-compliant shop drawings, Aluminum Association ADM 2020 spec."
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">03 / Expertise</span>
      <h1 style="margin-top: var(--space-3); max-width: 16ch;">Aluminum, end to end.</h1>
      <p style="margin-top: var(--space-4); max-width: 60ch;">
        GALVEC Studio is built around one specialization: structural and architectural
        aluminum systems for North American fabrication shops. The stack, standards,
        and process below are the same on every project — no exceptions.
      </p>
    </div>
  </section>

  <hr class="rule" />

  <section class="section" id="stack">
    <div class="container">
      <span class="section-num">01 / Software stack</span>
      <h2 style="margin-top: var(--space-3); margin-bottom: var(--space-5);">Tools we use daily</h2>

      <div class="grid grid-3 stack-grid">
        <div>
          <h4 class="stack__h">Primary</h4>
          <ul class="stack__list">
            {stack.primary.map(s => <li>{s}</li>)}
          </ul>
        </div>
        <div>
          <h4 class="stack__h">Secondary</h4>
          <ul class="stack__list">
            {stack.secondary.map(s => <li>{s}</li>)}
          </ul>
        </div>
        <div>
          <h4 class="stack__h">Output / Documentation</h4>
          <ul class="stack__list">
            {stack.output.map(s => <li>{s}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section" id="standards">
    <div class="container">
      <span class="section-num">02 / Standards</span>
      <h2 style="margin-top: var(--space-3); margin-bottom: var(--space-5); max-width: 24ch;">
        Drawings produced to comply with industry standards.
      </h2>

      <div class="standards">
        {standards.map(s => (
          <div class="standard">
            <span class="standard__code mono">{s.code}</span>
            <p class="standard__desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section" id="about">
    <div class="container about-grid">
      <div>
        <span class="section-num">03 / Founder</span>
        <h2 style="margin-top: var(--space-3); margin-bottom: var(--space-4);">About</h2>
      </div>
      <div>
        <p>
          GALVEC Studio was founded by <strong>C. Miranda</strong> — an aluminum
          fabrication engineer with 7+ years of experience modeling and documenting
          structural aluminum systems for shops across North America. Core stack:
          Autodesk Inventor, SolidWorks, AutoCAD.
        </p>
        <p style="margin-top: var(--space-3);">
          Remote-first studio. Project history concentrated in:
        </p>
        <ul class="region-list">
          <li><span class="mono">FL</span> Miami, West Palm Beach, Orlando, Tampa, Sarasota</li>
          <li><span class="mono">US</span> Available for remote engagements nationwide</li>
          <li><span class="mono">CA</span> Open to projects across all provinces</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .stack__h {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule);
  }
  .stack__list {
    display: grid;
    gap: var(--space-2);
  }
  .stack__list li {
    font-size: var(--step-1);
    font-family: var(--font-display);
    font-weight: 500;
  }
  .standards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0;
    border-top: var(--rule);
  }
  .standard {
    padding: var(--space-4);
    border-bottom: var(--rule);
    border-right: var(--rule);
  }
  .standard:last-child { border-right: 0; }
  .standard__code {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 500;
  }
  .standard__desc {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-5);
  }
  .region-list {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-2);
  }
  .region-list li {
    padding-left: 4rem;
    text-indent: -4rem;
  }
  .region-list .mono {
    display: inline-block;
    width: 3rem;
    color: var(--accent);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
  }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
    .standard { border-right: 0; }
  }
</style>
