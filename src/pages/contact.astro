---
import Base from '../layouts/Base.astro';

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/mdabpapq';
---
<Base
  title="Contact — GALVEC Studio"
  description="Talk to GALVEC about your next aluminum fabrication project. One business day response. Currently accepting projects."
>
  <section class="section">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">04 / Contact</span>
        <h1 style="margin-top: var(--space-3); max-width: 14ch;">
          Let's get your next package off your plate.
        </h1>
        <p style="margin-top: var(--space-4); max-width: 50ch;">
          Tell me what you're fabricating, when you need it, and where you're at
          in your pipeline. I'll respond within one business day with scope,
          timeline, and price.
        </p>

        <div class="sla">
          <div class="sla__row">
            <span class="card__num">Response</span>
            <span>Within 1 business day</span>
          </div>
          <div class="sla__row">
            <span class="card__num">Capacity</span>
            <span>Currently accepting new projects</span>
          </div>
          <div class="sla__row">
            <span class="card__num">Timezone</span>
            <span>Central Time · GMT-6</span>
          </div>
          <div class="sla__row">
            <span class="card__num">Direct</span>
            <a href="mailto:cm@galvecstudio.com">cm@galvecstudio.com</a>
          </div>
        </div>
      </div>

      <form
        class="contact-form stack"
        action={FORMSPREE_ENDPOINT}
        method="POST"
      >
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="company">Company / shop name</label>
          <input id="company" name="company" type="text" required autocomplete="organization" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="project_type">Project type</label>
          <select id="project_type" name="project_type" required>
            <option value="">Select…</option>
            <option>Staircases</option>
            <option>Façades / Curtain walls</option>
            <option>Railings</option>
            <option>Custom / Structural</option>
            <option>Constructability review</option>
          </select>
        </div>
        <div class="field">
          <label for="timeline">Timeline</label>
          <select id="timeline" name="timeline" required>
            <option value="">Select…</option>
            <option>This week</option>
            <option>2–4 weeks</option>
            <option>1–3 months</option>
            <option>TBD</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Project description</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <p class="attach-note mono">
          For DWG, DXF, PDF, or sketch references, email them directly to
          <a href="mailto:cm@galvecstudio.com?subject=Reference%20files">cm@galvecstudio.com</a>
          after sending this form.
        </p>

        <!-- Honeypot for spam -->
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

        <button type="submit" class="btn" style="margin-top: var(--space-3);">
          Send →
        </button>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }
  .sla {
    margin-top: var(--space-5);
    border-top: var(--rule);
  }
  .sla__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: var(--rule);
    font-size: 0.92rem;
  }
  .sla__row a { border-bottom: 1px solid var(--accent); }
  .contact-form { max-width: 36rem; }
  .attach-note {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--aluminum);
    background: var(--paper);
    line-height: 1.55;
    margin: 0;
  }
  .attach-note a {
    color: var(--accent);
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
