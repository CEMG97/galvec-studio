---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tiers = [
  {
    id: 'modeling',
    num: '01',
    name: 'Parametric Modeling',
    price: '$$',
    best_for: 'Shops that have architect intent drawings but need a fabrication-ready 3D model.',
    deliverables: [
      'Autodesk Inventor or SolidWorks assembly (native + STEP)',
      'Editable parametric features',
      'Bill of Materials (BOM) with material specs',
      'Render package (4 angles, native resolution)'
    ],
    turnaround: '3–7 business days'
  },
  {
    id: 'drawings',
    num: '02',
    name: 'Full Shop Drawing Package',
    price: '$$$',
    best_for: 'Shops that need a complete drawing set ready for the floor.',
    deliverables: [
      'Tier 01 deliverables',
      'Complete shop drawing set (AISC / AWS / ASME Y14.5 compliant)',
      'Per-part fabrication drawings with dimensions, tolerances, finish notes',
      'Welding callouts and joint details',
      'DWG and PDF formats'
    ],
    turnaround: '7–14 business days'
  },
  {
    id: 'review',
    num: '03',
    name: 'Engineering Partnership',
    price: 'Custom',
    best_for: 'Shops with recurring complex projects who want a dedicated engineering partner instead of one-off contracts.',
    deliverables: [
      'Everything in Tier 02',
      'Constructability reviews on incoming architect packages',
      'Standing Slack/Teams channel for design questions',
      'Reserved capacity (priority queue)'
    ],
    turnaround: 'Monthly retainer · 6-month minimum'
  }
];

const process = [
  { num: '01', label: 'Brief', desc: 'You share intent drawings, scope, and timeline.' },
  { num: '02', label: 'Model', desc: 'Parametric assembly built and reviewed internally.' },
  { num: '03', label: 'Review', desc: 'Joint review call — sign-off on model and BOM.' },
  { num: '04', label: 'Drawings', desc: 'Shop drawing set produced to your standard.' },
  { num: '05', label: 'Handoff', desc: 'Native files + DWG + PDF + revision support.' }
];
---
<Base
  title="Services — GALVEC Studio"
  description="Three modular engagement tiers for aluminum fabrication shops: parametric modeling, full shop drawing packages, and ongoing engineering partnership."
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">02 / Services</span>
      <h1 style="margin-top: var(--space-3); max-width: 16ch;">Engineering services for fabricators</h1>
      <p style="margin-top: var(--space-4); max-width: 60ch;">
        Three modular engagement tiers, priced per assembly or per package.
        Engage GALVEC at any point in your fabrication pipeline — concept,
        documentation, or pre-build review.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="tiers">
        {tiers.map(t => (
          <article class="tier" id={t.id}>
            <header class="tier__head">
              <span class="card__num">{t.num} / {t.price}</span>
              <h2 class="tier__name">{t.name}</h2>
              <p class="tier__best">Best for: {t.best_for}</p>
            </header>
            <div>
              <h4 class="tier__sub">Deliverables</h4>
              <ul class="tier__list">
                {t.deliverables.map(d => <li>{d}</li>)}
              </ul>
              <p class="mono tier__turnaround">Turnaround — {t.turnaround}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="container">
      <span class="section-num">04 / Process</span>
      <h2 style="margin-top: var(--space-3); margin-bottom: var(--space-5); max-width: 22ch;">
        Five steps from brief to handoff.
      </h2>

      <ol class="timeline">
        {process.map(s => (
          <li class="timeline__step">
            <span class="timeline__num mono">{s.num}</span>
            <h4 class="timeline__label">{s.label}</h4>
            <p class="timeline__desc">{s.desc}</p>
          </li>
        ))}
      </ol>

      <div style="margin-top: var(--space-6); text-align: center;">
        <a href={`${base}/contact`} class="btn">Start a project →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .tiers {
    display: grid;
    gap: var(--space-4);
  }
  .tier {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-5);
    border-top: 1px solid var(--ink);
    padding: var(--space-5) 0;
  }
  .tier__name {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 600;
    margin-block: var(--space-3);
  }
  .tier__best { color: var(--muted); max-width: 32ch; }
  .tier__sub {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-3);
    font-weight: 500;
  }
  .tier__list {
    display: grid;
    gap: var(--space-2);
  }
  .tier__list li {
    padding-left: 1.4rem;
    position: relative;
  }
  .tier__list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .tier__turnaround {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--aluminum);
    color: var(--accent);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }
  .timeline {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    border-top: var(--rule);
    border-bottom: var(--rule);
  }
  .timeline__step {
    padding: var(--space-4);
    border-right: var(--rule);
  }
  .timeline__step:last-child { border-right: 0; }
  .timeline__num {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  .timeline__label {
    font-family: var(--font-display);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .timeline__desc { font-size: 0.88rem; color: var(--muted); }

  @media (max-width: 820px) {
    .tier { grid-template-columns: 1fr; gap: var(--space-3); }
    .timeline { grid-template-columns: 1fr 1fr; }
    .timeline__step { border-right: 0; border-bottom: var(--rule); }
    .timeline__step:nth-child(2n) { border-right: 0; }
  }
</style>
