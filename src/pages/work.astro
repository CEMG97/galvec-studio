---
import Base from '../layouts/Base.astro';
import projects from '../data/projects.json';
const categories = ['All', ...Array.from(new Set(projects.map(p => p.category)))];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="Work — GALVEC Studio"
  description="Selected fabrication-ready aluminum projects: staircases, railings, canopies, roof access ladders, and custom systems delivered to fabricators."
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">01 / Work</span>
      <h1 style="margin-top: var(--space-3); max-width: 14ch;">Selected projects</h1>
      <p style="margin-top: var(--space-4); max-width: 60ch;">
        Selected fabrication-ready projects: 3D parametric models, welding
        assembly drawings, and installation packages delivered to fabrication
        shops. Renders are generated from production geometry; site photos are
        from real installations.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="filters" role="tablist" aria-label="Filter projects by category">
        {categories.map(cat => (
          <button class="filter" data-filter={cat} aria-pressed={cat === 'All'}>{cat}</button>
        ))}
      </div>

      <div class="grid grid-3 project-grid" style="margin-top: var(--space-5);">
        {projects.map(p => (
          <a class="project-card" data-category={p.category} href={`${base}/work/${p.slug}`}>
            <div class="project-card__cover">
              <img
                src={`${base}/projects/${p.slug}/${p.hero}`}
                alt={p.title}
                loading="lazy"
                width="800"
                height="600"
              />
            </div>
            <div class="card__num" style="margin-top: var(--space-3);">
              {p.category} · {p.renders.length + p.photos.length} images · drawings included
            </div>
            <h3 class="card__title" style="font-size: var(--step-1); margin-top: var(--space-2);">
              {p.title}
            </h3>
            <p style="margin-top: var(--space-2);">{p.summary}</p>
            <span class="card__cta mono">View project →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-top: var(--rule);
    padding-top: var(--space-4);
  }
  .filter {
    background: transparent;
    border: 1px solid var(--aluminum);
    padding: 0.55rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    transition: all 0.15s ease;
    cursor: pointer;
  }
  .filter:hover { border-color: var(--ink); color: var(--ink); }
  .filter[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .project-card {
    display: block;
    color: var(--ink);
    border: 1px solid transparent;
    padding: var(--space-3);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .project-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .project-card__cover {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--aluminum);
  }
  .project-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card__cta {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--accent);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('.project-card[data-category]');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filter;
      filters.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach(card => {
        const match = target === 'All' || card.dataset.category === target;
        card.style.display = match ? '' : 'none';
      });
    });
  });
</script>
