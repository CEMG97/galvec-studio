---
import Base from '../layouts/Base.astro';
import projects from '../data/projects.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = projects.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'GALVEC Studio',
  description: 'Aluminum engineering studio delivering fabrication-ready parametric 3D models and AISC/AWS-compliant shop drawings for fabrication shops in the US and Canada.',
  url: 'https://galvecstudio.com',
  email: 'cm@galvecstudio.com',
  serviceType: [
    'Aluminum engineering',
    'Parametric 3D modeling',
    'Shop drawings',
    'Constructability review'
  ],
  areaServed: [
    { '@type': 'Country', name: 'United States' },
    { '@type': 'Country', name: 'Canada' },
    { '@type': 'AdministrativeArea', name: 'Florida' }
  ],
  knowsAbout: [
    'Aluminum staircases', 'Aluminum railings', 'Curtain walls',
    'Structural aluminum', 'Autodesk Inventor', 'SolidWorks',
    'AISC', 'AWS', 'ASME Y14.5', 'ADM 2020'
  ]
};
---
<Base
  title="GALVEC Studio — Aluminum Engineering & Fabrication-Ready Shop Drawings"
  description="Aluminum engineering for fabrication shops: parametric Inventor and SolidWorks models, AISC/AWS shop drawings, and constructability review. Serving fab shops across Florida — Miami, West Palm Beach, Tampa, Orlando, Sarasota — and the rest of the US and Canada."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- HERO -->
  <section class="section hero">
    <div class="container">
      <span class="eyebrow">GALVEC Studio · Aluminum Engineering</span>
      <h1 class="hero__h">
        Fabrication-ready aluminum.<br/>
        <span class="hero__h-accent">Engineered upstream of your shop floor.</span>
      </h1>
      <p class="hero__sub">
        We deliver Inventor and SolidWorks models, tolerance-checked assemblies,
        and AISC-compliant shop drawings for aluminum staircases, railings, and
        curtain walls — built for fabricators across Florida, the wider US, and
        Canada who can't afford rework.
      </p>
      <div class="hero__cta">
        <a href={`${base}/work`} class="btn">View selected projects →</a>
        <a href={`${base}/contact`} class="btn btn--ghost">Request a quote</a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- STATS -->
  <section class="section--tight">
    <div class="container">
      <div class="grid grid-3">
        <div class="stat">
          <div class="stat__value">120+</div>
          <p class="stat__label">Aluminum assemblies delivered to North American fab shops.</p>
        </div>
        <div class="stat">
          <div class="stat__value">±0.5 <span class="mono" style="font-size:0.5em">mm</span></div>
          <p class="stat__label">Standard tolerance spec on parametric assemblies.</p>
        </div>
        <div class="stat">
          <div class="stat__value">3–5 <span class="mono" style="font-size:0.5em">days</span></div>
          <p class="stat__label">Typical turnaround on full shop drawing packages.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- SERVICES PREVIEW -->
  <section class="section">
    <div class="container">
      <span class="section-num">02 / What we do</span>
      <h2 style="margin-top: var(--space-3); margin-bottom: var(--space-5); max-width: 18ch;">
        Three engagement tiers. One engineering standard.
      </h2>

      <div class="grid grid-3">
        <article class="card">
          <div class="card__num">01 / Modeling</div>
          <h3 class="card__title">Parametric 3D Modeling</h3>
          <p>Inventor and SolidWorks assemblies built for fabricability — every part editable, every tolerance documented. BOM included.</p>
        </article>
        <article class="card">
          <div class="card__num">02 / Documentation</div>
          <h3 class="card__title">Shop Drawings</h3>
          <p>AISC and AWS compliant drawing sets your CNC, press brake, and welders can build from directly. No interpretation required.</p>
        </article>
        <article class="card">
          <div class="card__num">03 / Audit</div>
          <h3 class="card__title">Constructability Review</h3>
          <p>Pre-fabrication audit of architect drawings. Catch detail conflicts before they become RFIs on the shop floor.</p>
        </article>
      </div>

      <div style="margin-top: var(--space-5);">
        <a href={`${base}/services`} class="link-arrow">Full services breakdown →</a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- FEATURED PROJECTS -->
  <section class="section">
    <div class="container">
      <span class="section-num">03 / Selected work</span>
      <h2 style="margin-top: var(--space-3); margin-bottom: var(--space-5);">Recent fabrication-ready projects</h2>

      <div class="grid grid-3">
        {featured.map(p => (
          <a href={`${base}/work/${p.slug}`} class="card project-card">
            <figure class="project-card__cover">
              <img src={`${base}/projects/${p.slug}/${p.hero}`} alt={p.title} loading="lazy" width="1600" height="900" />
            </figure>
            <div class="card__num" style="margin-top: var(--space-3);">
              {p.category} · {p.drawings.length} {p.drawings.length === 1 ? 'sheet' : 'sheets'}
            </div>
            <h3 class="card__title" style="margin-top: var(--space-2);">{p.title}</h3>
            <p style="margin-top: var(--space-2); font-size: 0.92rem;">{p.summary}</p>
          </a>
        ))}
      </div>

      <div style="margin-top: var(--space-5);">
        <a href={`${base}/work`} class="link-arrow">All projects →</a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- MARKETS -->
  <section class="section--tight">
    <div class="container">
      <span class="section-num">04 / Markets</span>
      <h2 style="margin-top: var(--space-3); margin-bottom: var(--space-4); max-width: 22ch;">
        Florida-tested. Remote-first. North America-wide.
      </h2>
      <p style="max-width: 64ch; color: var(--muted);">
        Past project deliveries to fabrication shops in <strong>Miami</strong>,
        <strong>West Palm Beach</strong>, <strong>Orlando</strong>, <strong>Tampa</strong>,
        and <strong>Sarasota</strong> — aluminum staircases, balcony railings, curtain wall
        modeling, and structural assemblies. Now operating remote-first to support fab shops
        across the United States and Canada with the same documentation standard.
      </p>
      <ul class="markets-grid">
        <li><span class="card__num">Aluminum staircases</span><br/>Shop drawings for residential and commercial multi-flight assemblies.</li>
        <li><span class="card__num">Curtain wall modeling</span><br/>Parametric assemblies for façade contractors and glazing shops.</li>
        <li><span class="card__num">Balcony &amp; cable railings</span><br/>AISC/AWS-compliant railing systems with post-connection details.</li>
        <li><span class="card__num">Structural aluminum</span><br/>Custom welded assemblies, canopies, roof access ladders.</li>
      </ul>
    </div>
  </section>

  <hr class="rule" />

  <!-- CTA -->
  <section class="section blueprint">
    <div class="container" style="text-align:center;">
      <h2 style="max-width: 22ch; margin-inline: auto;">
        Outsourcing your engineering shouldn't feel like outsourcing risk.
      </h2>
      <div style="margin-top: var(--space-5);">
        <a href={`${base}/contact`} class="btn">Talk to GALVEC →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-8) var(--space-6); }
  .hero__h {
    margin-top: var(--space-4);
    max-width: 18ch;
    line-height: 1.05;
  }
  .hero__h-accent { color: var(--accent); }
  .hero__sub {
    margin-top: var(--space-4);
    font-size: var(--step-1);
    max-width: 56ch;
    color: var(--muted);
  }
  .hero__cta {
    margin-top: var(--space-5);
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .project-card {
    display: block;
    color: inherit;
    transition: transform 0.2s ease;
  }
  .project-card:hover { transform: translateY(-3px); }
  .project-card__cover {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--aluminum);
    background: var(--paper);
    overflow: hidden;
    margin: 0;
  }
  .project-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .project-card:hover .project-card__cover img { transform: scale(1.04); }
  .markets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
    border-top: var(--rule);
    padding-top: var(--space-5);
  }
  .markets-grid li {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .markets-grid .card__num {
    color: var(--ink);
    font-weight: 500;
  }
</style>
