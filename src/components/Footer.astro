---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img
          src={`${base}/galvec-lockup.svg`}
          alt="GALVEC Studio"
          class="footer-lockup"
          width="160"
          height="174"
        />
        <p class="mono footer-tagline">Aluminum Engineering · Fabrication-ready 3D modeling and shop drawings for North American fabrication shops.</p>
      </div>

      <div>
        <h3 class="footer-h">Services</h3>
        <ul class="footer-list">
          <li><a href={`${base}/services#modeling`}>Parametric Modeling</a></li>
          <li><a href={`${base}/services#drawings`}>Shop Drawings</a></li>
          <li><a href={`${base}/services#review`}>Constructability Review</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer-h">Resources</h3>
        <ul class="footer-list">
          <li><a href={`${base}/expertise#standards`}>Standards</a></li>
          <li><a href={`${base}/expertise#process`}>Process</a></li>
          <li><a href={`${base}/work`}>Selected Work</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer-h">Connect</h3>
        <ul class="footer-list">
          <li><a href="mailto:cm@galvecstudio.com">cm@galvecstudio.com</a></li>
          <li><a href={`${base}/contact`}>Project inquiry form</a></li>
        </ul>
      </div>
    </div>

    <hr class="rule" />

    <div class="footer-meta">
      <span class="mono">© {year} GALVEC Studio</span>
      <span class="mono">Remote-first · Serving US &amp; Canada</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    padding-block: var(--space-6);
    border-top: var(--rule);
    background: var(--paper);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }
  .footer-brand { max-width: 36ch; }
  .footer-lockup {
    width: 160px;
    height: auto;
    display: block;
    margin-bottom: var(--space-4);
    margin-left: -8px; /* compensate the SVG's internal left padding */
  }
  .footer-tagline {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .footer-h {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-3);
    font-weight: 500;
  }
  .footer-list { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer-list a {
    color: var(--ink);
    font-size: 0.92rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }
  .footer-list a:hover { border-color: var(--ink); }
  .footer-meta {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-4);
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-meta { flex-direction: column; gap: var(--space-2); }
  }
</style>
